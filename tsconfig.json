{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["node"],

    // 渐进迁移：允许 .js 与 .ts 混存，先把 types 标上去，后期再收紧
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // 只做类型检查，产物仍由 Vite / esbuild 负责
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // 允许 `from './foo.js'` 指向 `foo.ts` 源文件（迁移期关键）
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.vue", "tests/**/*.mjs"],
  "exclude": ["node_modules", "dist", "src-tauri", "public"]
}
